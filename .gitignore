# Git ignore for TrekGuard AI Flutter project

# ─── Dart/Flutter ────────────────────────────────────────────
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
.pub/
build/
*.g.dart
*.freezed.dart
*.config.dart

# ─── Secrets & Environment ───────────────────────────────────
.env
*.keystore
*.jks
*.p12
*.p8
*.mobileprovision
google-services.json
GoogleService-Info.plist

# ─── IDE ─────────────────────────────────────────────────────
.idea/
.vscode/settings.json
*.iml
*.ipr
*.iws

# ─── Android ─────────────────────────────────────────────────
**/android/**/gradle-wrapper.jar
**/android/.gradle
**/android/captures/
**/android/gradlew
**/android/gradlew.bat
**/android/local.properties
**/android/**/GeneratedPluginRegistrant.java
**/android/key.properties

# ─── iOS ─────────────────────────────────────────────────────
**/ios/**/*.mode1v3
**/ios/**/*.mode2v3
**/ios/**/*.moved-aside
**/ios/**/*.pbxuser
**/ios/**/*.perspectivev3
**/ios/**/xcuserdata
**/ios/.generated/
**/ios/Flutter/.last_build_id
**/ios/Podfile.lock

# ─── macOS ───────────────────────────────────────────────────
**/macos/Flutter/GeneratedPluginRegistrant.swift

# ─── Coverage ────────────────────────────────────────────────
coverage/

# ─── Fastlane ────────────────────────────────────────────────
fastlane/report.xml
fastlane/Preview.html
fastlane/screenshots/
fastlane/test_output/

# ─── AI Models (large files — use Git LFS or download script) ─
assets/models/*.tflite
assets/models/*.onnx

# ─── Offline Map Tiles (very large) ─────────────────────────
assets/maps/*.mbtiles

# ─── OS ──────────────────────────────────────────────────────
.DS_Store
Thumbs.db
