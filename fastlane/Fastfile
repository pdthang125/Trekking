  desc "iOS CI pipeline (requires Apple Developer account)"
  lane :ci do
    UI.message("iOS CI — configure signing certificates first")
    # match(type: "appstore")
    # sh("flutter build ios --release --no-codesign")
    # gym(...)
  end
end

# ─── Shared ───────────────────────────────────────────────────

desc "Print version info"
lane :version do
  UI.message("#{APP_NAME} — Package: #{PACKAGE_NAME}")
end
